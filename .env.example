# Copy to .env.local and fill in. .env*.local is gitignored; never commit a
# real key. On Vercel these go in Project Settings → Environment Variables,
# not in a file.

# From resend.com → API Keys. Without it /api/contact answers 503 and the
# contact form says email is not configured rather than showing a success
# state for a message that went nowhere.
RESEND_API_KEY=

# Optional. The From address on both the submission and the acknowledgement.
# Defaults to "Imam Shuaib <info@imamshuaib.com>".
#
# Resend refuses to send from a domain it has not verified by DNS, so until
# imamshuaib.com is verified in the Resend dashboard, set this to Resend's
# test sender to exercise the flow end to end:
#   CONTACT_FROM=Imam Shuaib <onboarding@resend.dev>
# Note that the test sender can only deliver to the address that owns the
# Resend account.
CONTACT_FROM=
